# RoleLens environment template (minimal)
# Copy this file to `.env.local` and fill only what you need:
#   cp .env.example .env.local

# Required for production auth security.
# For a new isolated database, use a long random value.
# When sharing an existing database, use the SAME pepper as its deployed Worker.
# Do not generate a new pepper for existing accounts.
AUTH_PASSWORD_PEPPER=

# Direct Postgres connection string for `npm run dev` (not a Supabase API URL/key).
# Use the same Supabase database + app DB role to share production account data.
# This overrides the emulated Hyperdrive build placeholder in next dev only.
# Deployed Workers use the Cloudflare HYPERDRIVE binding instead.
DATABASE_URL=

# For local Worker preview, set this in the shell environment before npm run preview.
# Use the same connection string as DATABASE_URL; remote Worker secrets are not copied.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Normalized scraper JSON URL fetched by /api/jobs/sync before it writes Postgres.
# The Python scraper still runs outside Cloudflare Pages; publish its output here.
PYTHON_SCRAPED_FEED_URL=

# Required only if you use /api/jobs/cron automation.
CRON_SECRET=

# Required for browser-triggered manual sync in deployed environments.
# Preferred: comma-separated lowercase/uppercase emails.
# Compatibility: SYNC_ADMIN_EMAIL also works for a single admin email.
SYNC_ADMIN_EMAILS=

# Required for /admin access. Falls back to SYNC_ADMIN_EMAILS when blank.
ADMIN_EMAILS=

# Optional backend override (`memory`/`postgres`; blank = auto/default behavior).
PERSISTENCE_BACKEND=
AUTH_BACKEND=
PERSISTENCE_DATABASE_BINDING=HYPERDRIVE

# Password reset emails: verified Cloudflare Email Sending domain + AUTH_EMAIL binding.
# The public HTTPS URL is used to construct recovery links; request Host is never trusted.
AUTH_PUBLIC_URL=
AUTH_EMAIL_FROM=
