{
  "name": "rolelens-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cloudflare": "npm run db:schema:local && npm run preview",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && npm run cf:deploy",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:schema:local": "wrangler d1 migrations apply rolelens-db --local",
    "db:schema:preview": "wrangler d1 migrations apply rolelens-db --preview",
    "db:schema:prod": "wrangler d1 migrations apply rolelens-db --remote"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mantine/core": "^7.17.8",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "typescript": "^5",
    "vite": "7.3.5",
    "vitest": "3.2.6",
    "wrangler": "^4.81.1"
  },
  "overrides": {
    "brace-expansion@1.1.13": "1.1.16",
    "brace-expansion@5.0.5": "5.0.8",
    "js-yaml@4.1.1": "4.3.0",
    "postcss@8.4.31": "8.5.18",
    "postcss@8.5.9": "8.5.18",
    "sharp@0.34.5": "0.35.2"
  }
}
